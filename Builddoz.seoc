from kivy.app import App
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.button import Button
from kivy.uix.label import Label


class JarvisApp(App):
    def build(self):
        layout = BoxLayout(orientation='vertical', padding=20, spacing=20)
        self.label = Label(text='Jarvis ready', font_size='24sp')
        button = Button(text='Speak', font_size='24sp', size_hint=(1, 0.3))
        button.bind(on_press=self.listen)
        layout.add_widget(self.label)
        layout.add_widget(button)
        return layout

    def listen(self, instance):
        self.label.text = 'Listening...'


JarvisApp().run()
2. buildozer.spec
[app]
title = Jarvis
package.name = jarvis
package.domain = org.jarvis
source.dir = .
source.include_exts = py,png,jpg,kv,atlas
version = 0.1
requirements = python3,kivy
orientation = portrait
fullscreen = 0
android.permissions = RECORD_AUDIO,INTERNET
android.api = 33
android.minapi = 21
android.archs = arm64-v8a
android.accept_sdk_license = True

[buildozer]
log_level = 2
warn_on_root = 1
3. .github/workflows/build.yml
फ़ाइल का नाम GitHub में लिखते समय पूरा रास्ता लिखो: .github/workflows/build.yml
name: Build APK

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Build with Buildozer
        uses: ArtemSBulgakov/buildozer-action@v1
        id: buildozer
        with:
          command: buildozer android debug
          buildozer_version: stable
      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: jarvis-apk
          path: ${{ steps.buildozer.outputs.filename }
